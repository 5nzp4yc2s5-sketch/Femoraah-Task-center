# Copy to .env.local for local development. Never commit real values.
# Supabase project URL and the public (anon / publishable) key: safe for the browser,
# but this app only uses them on the server.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret key (service role). Server-only: used for login lockout bookkeeping and creating logins.
# Set it in the hosting provider's encrypted environment settings, never in client code or git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
